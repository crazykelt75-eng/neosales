# =============================================================================
# NEOSALES — ENVIRONMENT CONFIGURATION (Botswana commerce)
# Copy to `.env.local` for local development. All values are optional: without
# them the store falls back to bundled defaults and localStorage persistence.
# =============================================================================

# --- Brand & seller contact ---------------------------------------------------
NEXT_PUBLIC_STORE_NAME="NeoSales"
NEXT_PUBLIC_SELLER_WHATSAPP="+26771550200"

# --- Botswana payment rails ---------------------------------------------------
# Orange Money merchant / agent number shown at checkout
NEXT_PUBLIC_ORANGE_MONEY_NUMBER="74453342"
# FNB Pay2Cell recipient cell number
NEXT_PUBLIC_FNB_PAY2CELL_NUMBER="71550200"
# Account name displayed beside both mobile money numbers
NEXT_PUBLIC_FNB_ACCOUNT_NAME="NeoSales Retail"

# --- Admin dashboard ----------------------------------------------------------
# 4-6 digit PIN protecting /admin (defaults to 2670 when unset)
NEXT_PUBLIC_ADMIN_PIN="2670"

# --- Canonical URL ------------------------------------------------------------
# Used by metadata, Open Graph, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL="https://neosales.crazykelt75.workers.dev"

# --- Supabase (optional live persistence) ------------------------------------
# When both values are present the catalog and orders sync to Supabase and the
# app switches to live mode automatically. Otherwise everything runs offline.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
